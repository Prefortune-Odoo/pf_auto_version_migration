<odoo>
  <data>

    <record model="ir.actions.act_window" id="pf_migration_ticket_action">
      <field name="name">Migration Tickets</field>
      <field name="res_model">pf.migration.ticket</field>
      <field name="view_mode">list,form</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Create your first migration ticket!
        </p>
        <p>
          Track and manage your migration tickets here.
        </p>
      </field>
    </record>

    <record model="ir.actions.act_window" id="pf_migration_wizard_action">
      <field name="name">Odoo Migration</field>
      <field name="res_model">pf.migration.wizard</field>
      <field name="view_mode">form,list</field>
      <field name="target">new</field>
    </record>

    <!-- Menu item -->
    <menuitem name="Odoo Migration" id="pf_auto_version_migration.menu_migration" sequence="10"/>
    <menuitem name="Start Migration" id="pf_auto_version_migration.sub_menu_migration" parent="pf_auto_version_migration.menu_migration" action="pf_migration_wizard_action" sequence="20"/>
    <menuitem name="Migration Tickets" id="pf_auto_version_migration.menu_migration_tickets" parent="pf_auto_version_migration.menu_migration" action="pf_migration_ticket_action" sequence="10"/>
  </data>
</odoo>
